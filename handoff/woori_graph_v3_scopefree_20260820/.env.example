# Docker services
POSTGRES_USER=woori_graph
POSTGRES_PASSWORD=change-me-local-only
RDB_PORT=5432
AGE_POSTGRES_USER=woori_graph
AGE_POSTGRES_PASSWORD=change-me-local-only
AGE_PORT=55432
OPENSEARCH_PORT=9200

# CLI service DSNs; the CLI derives a separate DB per build namespace.
RDB_ADMIN_DSN=postgresql://woori_graph:change-me-local-only@localhost:5432/postgres
AGE_ADMIN_DSN=postgresql://woori_graph:change-me-local-only@localhost:55432/postgres
OPENSEARCH_URL=http://localhost:9200

# Qwen3.8 vLLM OpenAI-compatible endpoint.
# The default is local-only so private company rules never leave this machine.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=local
VLLM_MODEL=Qwen/Qwen3.8-27B
# Begin with 4 and increase only after a pilot confirms the server can sustain it.
VLLM_CONCURRENCY=4
VLLM_ENABLE_THINKING=false
VLLM_TIMEOUT_SECONDS=120
VLLM_MAX_RETRIES=2
VLLM_MAX_TOKENS=1024
# False bypasses a global HTTP(S) proxy. Set true only when the vLLM endpoint
# must be reached through that proxy.
VLLM_TRUST_ENV=false

# Reject non-loopback LLM URLs. Set false only for an explicitly approved
# private endpoint.
SVO_LOCAL_ONLY=true
