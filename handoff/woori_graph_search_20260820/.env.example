# Local graph services
POSTGRES_USER=woori
POSTGRES_DB=graphdb
POSTGRES_PASSWORD=change-me-local-only
RDB_PORT=55432
OPENSEARCH_PORT=19200

# AGE is installed in the same graphdb PostgreSQL instance.
GRAPHDB_DSN=postgresql://woori@127.0.0.1:55432/graphdb
OPENSEARCH_URL=http://127.0.0.1:19200

# Qwen3.8 vLLM OpenAI-compatible endpoint.
# The default is local-only so private company rules never leave this machine.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=local
VLLM_MODEL=Qwen/Qwen3.8-27B
# Begin with 4 and increase only after a pilot confirms the server can sustain it.
VLLM_CONCURRENCY=4
VLLM_ENABLE_THINKING=false
VLLM_TIMEOUT_SECONDS=120
VLLM_MAX_RETRIES=2
VLLM_MAX_TOKENS=1024
# False bypasses a global HTTP(S) proxy. Set true only when the vLLM endpoint
# must be reached through that proxy.
VLLM_TRUST_ENV=false

# Reject non-loopback LLM URLs. Set false only for an explicitly approved
# private endpoint.
SVO_LOCAL_ONLY=true

# OpenAI-compatible embedding endpoint. Run a separate local pooling model,
# for example BAAI/bge-m3 (1024 dimensions), through vLLM or TEI.
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_RETRIES=2
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_QUERY_PREFIX=
EMBEDDING_NORMALIZE=true
EMBEDDING_TRUST_ENV=false
EMBEDDING_LOCAL_ONLY=true

# Search pipeline RDB connection. Keep real passwords only in .env or the
# internal secret manager, never in source/config files.
GRAPH_POSTGRES_DSN=postgresql://woori@127.0.0.1:55432/graphdb
